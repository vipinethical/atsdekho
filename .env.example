# Razorpay Dashboard → API Keys (test keys start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Optional. If empty, we create/reuse an "ATSDekho monthly" plan via the API.
# RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxxx

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI: https://atsdekho.in/api/auth/callback/google
# Local: http://localhost:3000/api/auth/callback/google
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=xxxxxxxxxxxxxxxx
AUTH_URL=https://atsdekho.in

NEXT_PUBLIC_SITE_URL=https://atsdekho.in

# PostHog → Project settings → Project API key. Leave empty to skip PostHog.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
